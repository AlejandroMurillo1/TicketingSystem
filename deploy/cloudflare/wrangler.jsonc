{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cinereserva-api",
  "account_id": "5dd9f1e985ed9209578b0431c2f4848e",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Lets the Durable Object tell which deploy started the running container
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "containers": [
    {
      "class_name": "ApiContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          // Same Dockerfile used locally and in CI, built from the repo root
          "dockerfile": "../../Dockerfile",
          "build_context": "../.."
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "ApiContainer", "name": "API_CONTAINER" }]
  },
  "exports": {
    "ApiContainer": { "type": "durable-object", "storage": "sqlite" }
  },
  // Non-secret config. DATABASE_URL and JWT_SECRET are set with `wrangler secret put`.
  "vars": {
    "DB_SSL": "true",
    "DB_SYNCHRONIZE": "true",
    "JWT_EXPIRES_IN": "2h",
    "TWO_FACTOR_ISSUER": "CineReserva"
  }
}
